# ============================================================
# FastLink Bot — шаблон окружения для локальной разработки
# Синхронизирован с settings_schema.py (pydantic-settings v2)
#
# Использование:
#   Локальная разработка : cp .env.example .env
#   VPS / production     : НЕ ИСПОЛЬЗУЕТСЯ — .env собирается автоматически
#                          через .env.production.template + GitHub Environment secrets
#
# Правила:
#   - НЕ коммить .env (в .gitignore).
#   - Держать этот файл в синхроне с settings_schema.py.
#   - Добавлять переменную сюда только если она добавлена в settings_schema.py.
#   - Вычисляемые DSN (DATABASE_URL, REDIS_URL_*) не нужны —
#     они собираются автоматически из POSTGRES_* и REDIS_* переменных.
# ============================================================


# ============================================================
# РЕЖИМ ЗАПУСКА
# ============================================================
# APP_ENV управляет профилем запуска:
#   development  → локальная разработка, polling, моки опциональны
#   production   → VPS, webhook, реальные интеграции (не использовать локально!)
#   test         → автоматические тесты (pytest)
APP_ENV=development

# Включить подробный вывод. Ставить true только для активной отладки.
APP_DEBUG=true

# Уровень логирования Structlog: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG


# ============================================================
# TELEGRAM BOT
# ============================================================
# Получить от @BotFather. Использовать отдельного бота для dev и prod.
BOT_TOKEN=CHANGE_ME_BOT_TOKEN

# Ваш личный Telegram ID (число).
# Узнать через @userinfobot. Используется для создания первого суперадмина.
OWNER_TELEGRAM_ID=000000000

# Режим парсинга сообщений для aiogram DefaultBotProperties.
# По умолчанию в settings_schema.py HTML — задавать только если меняешь.
# BOT_PARSE_MODE=HTML


# ============================================================
# WEBHOOK / HTTP
# ============================================================
# --- Локальная разработка ---
# Типичная настройка локально:
#   USE_WEBHOOK=false         → бот работает через polling, HTTP-сервер не нужен
#   WEBHOOK_BASE_URL          → можно оставить заглушку, когда webhook отключён
#
# --- Production / VPS ---
# Типичная настройка на проде (НЕ МЕНЯТЬ ЛОКАЛЬНО):
#   USE_WEBHOOK=true
#   WEBHOOK_BASE_URL=https://fastlinkproject.com
#   WEBHOOK_SECRET должен быть реальной случайной строкой (openssl rand -hex 32)

USE_WEBHOOK=false

# Если true, бот запускается без регистрации webhook в Telegram.
# Полезно, если Nginx / Telegram-сторона ещё не готовы.
SKIP_WEBHOOK_REGISTRATION=false

# Публичный HTTPS базовый URL (без слэша в конце).
WEBHOOK_BASE_URL=http://localhost:8080

# Путь webhook. Nginx проксирует /webhook → 127.0.0.1:8080/webhook
WEBHOOK_PATH=/webhook

# Секретный токен, который Telegram шлёт в заголовке X-Telegram-Bot-Api-Secret-Token.
# Сгенерировать: openssl rand -hex 32
WEBHOOK_SECRET=local_secret_not_used

# Внутренний путь health, который обслуживает HTTP-сервер бота.
# По умолчанию в settings_schema.py /health — задавать только если меняешь.
# HEALTHCHECK_PATH=/health

# Адрес и порт HTTP-сервера бота (внутри контейнера / runtime приложения).
# По умолчанию в settings_schema.py: 0.0.0.0 / 8080 — переопределять только если нужно.
HTTP_HOST=0.0.0.0
HTTP_PORT=8080


# ============================================================
# POSTGRESQL
# ============================================================
POSTGRES_DB=fastlink
POSTGRES_USER=fastlink
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# --- Локальная разработка ---
# Если используешь docker-compose.override.yml (см. блок внизу этого файла),
# то можно раскомментировать эти строки для доступа к Postgres с хоста:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
#
# Это позволит:
#   - Подключаться к Postgres через psql / DBeaver / IDE на хосте (localhost:5432)
#   - Запускать alembic check / alembic upgrade напрямую с хоста (не в контейнере)
#
# --- Production / VPS ---
# Оставить закомментированным — бот будет ходить в Postgres внутри Docker-сети:
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432


# ============================================================
# REDIS
# ============================================================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Hostname "redis" = имя сервиса в Docker Compose.
REDIS_HOST=redis
REDIS_PORT=6379

# Логические базы данных:
#   0  main / default
#   1  FSM   (aiogram RedisStorage)
#   2  cache
#   3  rate limiting / throttling
#   4  payment idempotency
#   5  Marzban token cache
#   6  taskqueue (ARQ)
REDIS_DB=0
REDIS_FSM_DB=1
REDIS_CACHE_DB=2
REDIS_RATE_LIMIT_DB=3
REDIS_PAYMENT_DB=4
REDIS_MARZBAN_TOKEN_DB=5
REDIS_TASKQUEUE_DB=6

# Полные Redis DSN — должны соответствовать REDIS_PASSWORD / REDIS_HOST / REDIS_PORT выше.
# В settings_schema.py они вычисляются автоматически — можно не задавать вручную.
# Оставлены для совместимости, но не обязательны.
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_URL_FSM=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
REDIS_URL_CACHE=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/2
REDIS_URL_RATE_LIMIT=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/3
REDIS_URL_PAYMENT=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/4
REDIS_URL_MARZBAN_TOKEN=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/5
REDIS_URL_TASKQUEUE=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/6


# ============================================================
# ADMIN / SESSION
# ============================================================
# TTL сессии админа в Redis (секунды). По умолчанию: 28800 = 8 часов.
# ADMIN_SESSION_TTL_SECONDS=28800


# ============================================================
# MARZBAN API
# ============================================================
# FastLink ходит в Marzban через host.docker.internal, потому что
# Marzban работает в host-network режиме, а FastLink — в bridge (bot-net).
# Production: http://host.docker.internal:8000/api
# Local dev (WSL2 / Docker Desktop): аналогично, или использовать IP хоста.
MARZBAN_API_BASE=http://localhost:8000
MARZBAN_USERNAME=CHANGE_ME_MARZBAN_USERNAME
MARZBAN_PASSWORD=CHANGE_ME_MARZBAN_PASSWORD

# Таймаут HTTP-клиента для запросов к Marzban API (секунды).
# По умолчанию в settings_schema.py 10 — задавать только если нужно менять.
# MARZBAN_TIMEOUT_SECONDS=10

# Политика повторных попыток для запросов к Marzban API.
# MARZBAN_MAX_RETRIES — сколько дополнительных попыток делать при временных ошибках.
# MARZBAN_BACKOFF_BASE_SECONDS — базовая задержка для экспоненциальной отсрочки.
# По умолчанию в settings_schema.py: 2 попытки, 0.5 секунды.
# MARZBAN_MAX_RETRIES=2
# MARZBAN_BACKOFF_BASE_SECONDS=0.5


# ============================================================
# METRICS
# ============================================================
# metrics-agent слушает 127.0.0.1:9100, Nginx проксирует /metrics туда.
# Production пример: https://fastlinkproject.com/metrics
METRICS_URL=http://localhost:9100/metrics

# Bearer токен для endpoints метрик.
# Должен совпадать с METRICS_TOKEN в /opt/metrics-agent/.env на VPS.
# Сгенерировать: openssl rand -hex 32
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN


# ============================================================
# CRYPTO / MASTER KEY
# ============================================================
# Мастер-ключ для шифрования на уровне приложения (servers.api_token, servers.metrics_token).
# Должен быть 32-байтным случайным значением, в hex-кодировке.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
FASTLINK_CRYPTO_MASTER_KEY=CHANGE_ME_FASTLINK_CRYPTO_MASTER_KEY


# ============================================================
# ЯЗЫК / I18N
# ============================================================
# Язык по умолчанию для новых пользователей.
# Переключается через кнопку "🌐 Язык" в главном меню.
DEFAULT_LANGUAGE=ru


# ============================================================
# YOOKASSA
# ============================================================
# Оставить пустым, пока платежи не включены (Phase 4+).
# Получить реквизиты на https://yookassa.ru/my/shop-settings/integration
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Лимиты донатов в копейках (1 RUB = 100 kopecks)
DONATION_MIN_AMOUNT_KOPECKS=5000
DONATION_MAX_AMOUNT_KOPECKS=5000000


# ============================================================
# SUPPORT BOT
# ============================================================
# Support bot (опционально, для Phase 5+)
SUPPORT_BOT_TOKEN=CHANGE_ME_SUPPORT_BOT_TOKEN
SUPPORT_BOT_USERNAME=test_fastlinkbot_support_bot
FEATURE_SUPPORT_ENABLED=true


# ============================================================
# FEATURE FLAGS
# ============================================================
# Отключить фичи, которые ещё не реализованы, для стабильности бота.
FEATURE_ADMIN_ENABLED=true
FEATURE_PAYMENTS_ENABLED=false
FEATURE_REFUNDS_ENABLED=false


# ============================================================
# ЛОКАЛЬНАЯ РАЗРАБОТКА — docker-compose.override.yml
# ============================================================
# Для удобной локальной разработки настоятельно рекомендуется создать
# docker-compose.override.yml рядом с docker-compose.yml. Этот файл
# НЕ попадает в репозиторий (добавлен в .gitignore) и переопределяет
# только локальные настройки — на проде он отсутствует.
#
# Пример содержимого docker-compose.override.yml:
#
# services:
#   bot:
#     # Сборка образа локально (чтобы не требовать FASTLINK_IMAGE из .env)
#     build:
#       context: .
#       dockerfile: Dockerfile
#     # Монтирование кода в контейнер для hot-reload без пересборки
#     volumes:
#       - .:/app          # Исходники проекта в /app внутри контейнера
#       - /app/logs       # Логи пишутся на хост в ./logs
#
#   worker:
#     # Аналогично bot — сборка и volumes для worker.py
#     build:
#       context: .
#       dockerfile: Dockerfile
#     volumes:
#       - .:/app
#       - /app/logs
#
#   postgres:
#     # Проброс порта Postgres наружу для подключения через psql / DBeaver / IDE
#     # Работает только с этим override — на проде порта нет (безопасность)
#     ports:
#       - "127.0.0.1:5432:5432"
#
# После создания docker-compose.override.yml:
#   1. Раскомментируй POSTGRES_HOST=localhost и POSTGRES_PORT=5432 в блоке POSTGRESQL выше.
#   2. Запусти: docker-compose up -d --build
#   3. Для последующих перезапусков: docker-compose restart
#   4. Alembic можно запускать снаружи: alembic check, alembic upgrade head
#   5. Подключаться к Postgres: psql "postgresql://fastlink:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/fastlink"
#
# См. .gitignore для файлов, которые никогда не должны попадать в репозиторий:
#   - .env
#   - docker-compose.override.yml
#   - logs/*
#   - deploy/state/* (кроме .gitkeep)
