# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenv
.venv/
venv/
.venv*/
env/

# Environment
.env
.env.*
!.env.example
!.env.production.template

# Logs
logs/*
!logs/.gitkeep
*.log

# Alembic / local artifacts
alembic/versions/*.pyc

# OS / editors
.DS_Store
.idea/
.vscode/

# Coverage / build
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Docker local overrides
docker-compose.override.yml

# Local backups / temp
*.bak
*.bak_*
*.bak-*
*.before_drop_types
*~
tmp/

# Локальный дамп проекта
project_dump_1.txt
*.dump.txt
dump/

# Deploy healthcheck marker
.healthcheck-status

# Tests
coverage.xml
tests/reports/*
!tests/reports/.gitkeep
.hypothesis/

# Runtime state files — генерируются на сервере деплой-скриптом,
# в репозитории должна быть только пустая папка (см. .gitkeep)
deploy/state/*
!deploy/state/.gitkeep

# Server checkout
deploy/reports/scheduled-check/*
!deploy/reports/scheduled-check/.gitkeep
